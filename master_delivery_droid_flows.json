  {
    "id": "telemetry_metrics_filter",
    "type": "function",
    "z": "tab_tls_telemetry",
    "name": "Enrich & Validate Telemetry",
    "func": "const topicParts = msg.topic.split('/');\nconst droidId = topicParts[1] || msg.payload.droid_id || 'UNKNOWN_DROID';\nconst data = msg.payload;\n\nmsg.telemetry = {\n    droid_id: droidId,\n    timestamp: data.timestamp || new Date().toISOString(),\n    gps: {\n        lat: data.gps?.lat || 0,\n        lon: data.gps?.lon || 0,\n        alt_m: data.gps?.alt_m || 0,\n        speed_kmh: data.gps?.speed_kmh || 0\n    },\n    battery: {\n        voltage_v: data.battery?.voltage || 0,\n        soc_pct: data.battery?.soc_pct || 0,\n        temp_c: data.battery?.temp_c || 25\n    },\n    compartment: {\n        locked: data.compartment?.locked ?? true,\n        door_closed: data.compartment?.door_closed ?? true,\n        temperature_c: data.compartment?.temperature_c || 20\n    },\n    network: {\n        rssi: data.network?.rssi || -75,\n        carrier: data.network?.carrier || '4G-LTE-Rural'\n    }\n};\n\nmsg.payload = msg.telemetry;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 120,
    "wires": [
      [
        "debug_enriched_telemetry"
      ]
    ]
  },
