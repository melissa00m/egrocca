  {
    "id": "fn_classify_tamper",
    "type": "function",
    "z": "tab_anti_tamper",
    "name": "Triage & Enrich Incident",
    "func": "const topicSegments = (msg.topic || '').split('/');\nconst droidId = topicSegments[1] || msg.payload.droid_id || 'UNKNOWN_DROID';\nconst raw = msg.payload;\nconst incidentId = 'INC-' + Date.now().toString(36).toUpperCase();\nconst timestamp = raw.timestamp || new Date().toISOString();\n\nlet severity = 'WARNING';\nlet requiresLockdown = false;\nconst eventType = raw.event_type || 'UNKNOWN_TAMPER_EVENT';\n\nif (eventType.includes('PRIED_OPEN') || \n    eventType.includes('CHASSIS_BREACH') || \n    eventType.includes('FORCE_ENTRY') ||\n    raw.sensors?.compartment_switch === 'BREACHED') {\n    severity = 'CRITICAL';\n    requiresLockdown = true;\n} else if (eventType.includes('MULTIPLE_UNAUTHORIZED_RFID') || raw.sensors?.rfid_failed_count >= 3) {\n    severity = 'HIGH';\n    requiresLockdown = true;\n} else if (raw.sensors?.vibration_g > 3.0 || raw.sensors?.imu_tilt_deg > 45) {\n    severity = 'WARNING';\n}\n\nconst auditRecord = {\n    incident_id: incidentId,\n    droid_id: droidId,\n    timestamp: timestamp,\n    severity: severity,\n    event_type: eventType,\n    details: raw.details || raw.reason || 'Sensor limit switch tripped without authorized unlock',\n    location: {\n        lat: raw.location?.latitude || raw.location?.lat || -29.8587,\n        lon: raw.location?.longitude || raw.location?.lon || 31.0218,\n        alt_m: raw.location?.altitude_m || 120.0\n    },\n    sensors: {\n        compartment_locked: raw.sensors?.compartment_locked ?? true,\n        door_switch_state: raw.sensors?.door_switch || 'OPEN',\n        rfid_failed_count: raw.sensors?.rfid_failed_count || 0,\n        tilt_deg: raw.sensors?.imu_tilt_deg || 0,\n        shock_g: raw.sensors?.vibration_g || 0\n    },\n    battery_pct: raw.battery_soc_pct || raw.battery?.soc_pct || 85\n};\n\nconst logMsg = {\n    ...msg,\n    payload: auditRecord,\n    incident_id: incidentId,\n    severity: severity\n};\n\nlet countermeasureMsg = null;\nif (requiresLockdown) {\n    countermeasureMsg = {\n        topic: `droid/${droidId}/command/lockdown`,\n        payload: {\n            command: 'ENGAGE_EMERGENCY_LOCKDOWN',\n            incident_id: incidentId,\n            droid_id: droidId,\n            timestamp: new Date().toISOString(),\n            actions: {\n                energize_secondary_deadbolt: true,\n                sound_alarm_siren: true,\n                flash_strobe_leds: true,\n                disable_drive_motors: true,\n                capture_camera_snapshot: true\n            }\n        }\n    };\n}\n\nreturn [logMsg, countermeasureMsg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 140,
    "wires": [
      [
        "fn_format_log_line",
        "debug_incident_alert"
      ],
      [
        "mqtt_out_lockdown",
        "debug_countermeasures"
      ]
    ]
  },
