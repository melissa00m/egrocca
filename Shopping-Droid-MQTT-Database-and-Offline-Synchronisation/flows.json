        "name": "customer order",
        "func": "const order = {\n    customer_id: 1,\n    product_id: 1,\n    quantity: 2\n};\n\nmsg.topic = `\nSELECT product_id, product_name, quantity, unit_price\nFROM inventory\nWHERE product_id = ${order.product_id}\n`;\n\nmsg.order = order;\n\nreturn msg;",
