        "id": "b18672cb20b1f762",
        "type": "function",
        "z": "8f517b7e76244d29",
        "name": "offline sql",
        "func": "\nconst originalTopic = msg.topic;\nconst data = msg.payload;\n\nconst safeTopic = String(originalTopic).replace(/'/g, \"''\");\nconst safePayload = JSON.stringify(data).replace(/'/g, \"''\");\n\nmsg.topic = `\n    INSERT INTO offline_queue\n        (topic, payload, retry_count, synced)\n    VALUES\n        ('${safeTopic}', '${safePayload}', 0, 0)\n`;\n\ndelete msg.payload;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
