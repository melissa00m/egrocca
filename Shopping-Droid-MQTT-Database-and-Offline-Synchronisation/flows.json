    {
        "id": "1defa190320816d8",
        "type": "function",
        "z": "8ecb6cf9e2e65492",
        "name": "prepare msg",
        "func": "const queueId = Number(msg._queueId);\n\nif (!Number.isInteger(queueId) || queueId < 1) {\n    node.error(\"Missing or invalid queue ID\", msg);\n    return null;\n}\n\nif (msg.statusCode === 200 &&\n    msg.payload &&\n    msg.payload.success === true) {\n\n    msg.topic =\n        \"UPDATE offline_queue SET synced = 1 WHERE queue_id = \" +\n        queueId;\n\n} else {\n\n    msg.topic =\n        \"UPDATE offline_queue SET retry_count = retry_count + 1 WHERE queue_id = \" +\n        queueId;\n}\n\ndelete msg.payload;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 90,
