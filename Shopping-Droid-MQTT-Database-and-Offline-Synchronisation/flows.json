    {
        "id": "942fbd1f2d26d6b3",
        "type": "function",
        "z": "b49a34ab988a9508",
        "name": "product availability",
        "func": "const product = msg.payload[0];\nconst order = msg.order;\n\nif (!product) {\n    msg.payload = \"Product not found\";\n    return [null, msg];\n}\n\nif (product.quantity < order.quantity) {\n    msg.payload = \"Not enough stock available\";\n    return [null, msg];\n}\n\nmsg.order.total_amount = product.unit_price * order.quantity;\nmsg.order.unit_price = product.unit_price;\n\nmsg.payload = msg.order;\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
