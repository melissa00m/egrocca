    {
        "id": "61663d905eb89e7e",
        "type": "function",
        "z": "45b16974b32c6295",
        "name": "Prepare Telementry SQL",
        "func": "\nconst data = msg.payload;\n\n// Convert the sensor message to JSON text\nconst sensorData = JSON.stringify(data);\n\n// Escape single quotes for SQL\nconst safeData = sensorData.replace(/'/g, \"''\");\n\n// Build the SQL statement\nmsg.topic = \"INSERT INTO telemetry (topic, payload, synced) VALUES ('droid/sensor', '\" +\n    safeData +\n    \"', 0)\";\n\n// Remove the old payload so the SQLite node doesn't use stale parameters\ndelete msg.payload;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
