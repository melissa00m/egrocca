  {
    "id": "egr0cca000000009",
    "type": "function",
    "z": "egr0cca000000001",
    "name": "Validate and store sensor status",
    "func": "const body = msg.payload;\nif (!body || typeof body !== 'object' || Array.isArray(body)) {\n    msg.statusCode = 400;\n    msg.payload = {error: 'Send a JSON object.'};\n    return msg;\n}\nconst keys = ['camera_online', 'lidar_online'];\nconst supplied = keys.filter((key) => body[key] !== undefined);\nif (supplied.length === 0 && body.camera_stream_url === undefined) {\n    msg.statusCode = 400;\n    msg.payload = {error: 'Provide camera_online, lidar_online, or camera_stream_url.'};\n    return msg;\n}\nfor (const key of supplied) {\n    if (typeof body[key] !== 'boolean') {\n        msg.statusCode = 400;\n        msg.payload = {error: key + ' must be a boolean.'};\n        return msg;\n    }\n}\nif (body.camera_stream_url !== undefined && (typeof body.camera_stream_url !== 'string' || !/^https?:\\/\\//i.test(body.camera_stream_url))) {\n    msg.statusCode = 400;\n    msg.payload = {error: 'camera_stream_url must be an HTTP or HTTPS URL.'};\n    return msg;\n}\nconst status = flow.get('status') || {};\nfor (const key of supplied) status[key] = body[key];\nif (body.camera_stream_url !== undefined) status.camera_stream_url = body.camera_stream_url;\nstatus.updated_at = new Date().toISOString();\nflow.set('status', status);\nmsg.statusCode = 202;\nmsg.payload = {ok: true, received_at: status.updated_at};\nreturn msg;",
    "outputs": 1,
