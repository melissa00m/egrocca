    "id": "egr0cca000000006",
    "type": "function",
    "z": "egr0cca000000001",
    "name": "Validate and store alert",
    "func": "const body = msg.payload;\nif (!body || typeof body !== 'object' || Array.isArray(body) || typeof body.obstacle_detected !== 'boolean') {\n    msg.statusCode = 400;\n    msg.payload = {error: 'Send JSON with a boolean obstacle_detected field.'};\n    return msg;\n}\nif (body.distance_m !== undefined && (typeof body.distance_m !== 'number' || !Number.isFinite(body.distance_m) || body.distance_m < 0)) {\n    msg.statusCode = 400;\n    msg.payload = {error: 'distance_m must be a non-negative number.'};\n    return msg;\n}\nif (body.message !== undefined && typeof body.message !== 'string') {\n    msg.statusCode = 400;\n    msg.payload = {error: 'message must be a string.'};\n    return msg;\n}\nconst status = flow.get('status') || {};\nstatus.obstacle_detected = body.obstacle_detected;\nif (body.distance_m !== undefined) status.distance_m = body.distance_m;\nstatus.last_alert = body.message || (body.obstacle_detected ? 'Obstacle detected.' : 'Obstacle cleared.');\nstatus.updated_at = new Date().toISOString();\nflow.set('status', status);\nmsg.statusCode = 202;\nmsg.payload = {ok: true, received_at: status.updated_at};\nreturn msg;",
