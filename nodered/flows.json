  {
    "id": "egr0cca000000003",
    "type": "template",
    "z": "egr0cca000000001",
    "name": "Dashboard HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Egrocca sensor dashboard</title>\n  <style>\n    body{font:16px system-ui,sans-serif;max-width:900px;margin:2rem auto;padding:0 1rem;background:#f4f6f8;color:#18212b}\n    h1{font-size:1.6rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem}\n    section{background:white;border:1px solid #d5dce3;border-radius:8px;padding:1rem}\n    .value{font-size:1.25rem;font-weight:650}.ok{color:#147a3d}.bad{color:#b42318}.muted{color:#5d6875}\n    input{box-sizing:border-box;width:min(100%,32rem);padding:.55rem}button{padding:.6rem;margin-left:.3rem}\n    img{display:block;max-width:100%;margin-top:1rem;background:#111;min-height:120px}\n  </style>\n</head>\n<body>\n  <h1>Egrocca sensor dashboard</h1>\n  <p id=\"connection\" class=\"muted\">Connecting to Node-RED…</p>\n  <div class=\"grid\">\n    <section><h2>Obstacle</h2><p id=\"obstacle\" class=\"value\">Unknown</p><p>Nearest range: <span id=\"distance\">—</span></p></section>\n    <section><h2>Camera</h2><p id=\"camera\" class=\"value\">Unknown</p><p class=\"muted\">A browser-readable HTTP/MJPEG stream URL is required for video.</p></section>\n    <section><h2>LiDAR</h2><p id=\"lidar\" class=\"value\">Unknown</p><p class=\"muted\">Status is reported by the sensor client.</p></section>\n  </div>\n  <section><h2>Latest alert</h2><p id=\"alert\">No alerts received yet.</p><p id=\"updated\" class=\"muted\"></p></section>\n  <section>\n    <h2>Live camera view</h2>\n    <label for=\"stream-url\">HTTP or MJPEG stream URL</label><br>\n    <input id=\"stream-url\" type=\"url\" placeholder=\"http://robot-host:8080/stream.mjpg\">\n    <button id=\"show-stream\" type=\"button\">Show stream</button>\n    <img id=\"camera-feed\" alt=\"Live camera stream\" hidden>\n    <p id=\"stream-message\" class=\"muted\">No camera stream URL configured.</p>\n  </section>\n  <script>\n    const connection = document.getElementById('connection');\n    const streamInput = document.getElementById('stream-url');\n    const cameraFeed = document.getElementById('camera-feed');\n    const streamMessage = document.getElementById('stream-message');\n    function setStatus(id, value) {\n      const element = document.getElementById(id);\n      if (value === true) { element.textContent = 'Online'; element.className = 'value ok'; }\n      else if (value === false) { element.textContent = 'Offline'; element.className = 'value bad'; }\n      else { element.textContent = 'Unknown'; element.className = 'value muted'; }\n    }\n    function showStream(url) {\n      if (!url) { cameraFeed.hidden = true; streamMessage.textContent = 'No camera stream URL configured.'; return; }\n      cameraFeed.src = url;\n      cameraFeed.hidden = false;\n      streamMessage.textContent = 'If the image does not load, check the stream URL and camera streamer.';\n    }\n    document.getElementById('show-stream').addEventListener('click', function () { showStream(streamInput.value.trim()); });\n    cameraFeed.addEventListener('error', function () { streamMessage.textContent = 'Could not load the stream. Check the URL and confirm it serves browser-compatible images or MJPEG.'; });\n    async function refresh() {\n      try {\n        const response = await fetch('/api/status', {cache: 'no-store'});\n        if (!response.ok) throw new Error('HTTP ' + response.status);\n        const result = await response.json();\n        const status = result.status || {};\n        connection.textContent = 'Connected to Node-RED';\n        connection.className = 'ok';\n        if (status.camera_stream_url && !streamInput.value) { streamInput.value = status.camera_stream_url; showStream(status.camera_stream_url); }\n        setStatus('camera', status.camera_online);\n        setStatus('lidar', status.lidar_online);\n        const obstacle = document.getElementById('obstacle');\n        if (typeof status.obstacle_detected === 'boolean') {\n          obstacle.textContent = status.obstacle_detected ? 'DETECTED' : 'Clear';\n          obstacle.className = status.obstacle_detected ? 'value bad' : 'value ok';\n        } else { obstacle.textContent = 'Unknown'; obstacle.className = 'value muted'; }\n        document.getElementById('distance').textContent = typeof status.distance_m === 'number' ? status.distance_m.toFixed(2) + ' m' : '—';\n        document.getElementById('alert').textContent = status.last_alert || 'No alerts received yet.';\n        document.getElementById('updated').textContent = status.updated_at ? 'Last update: ' + status.updated_at : '';\n      } catch (error) {\n        connection.textContent = 'Node-RED status unavailable: ' + error.message;\n        connection.className = 'bad';\n      }\n    }\n    refresh();\n    setInterval(refresh, 1000);\n  </script>\n</body>\n</html>",
    "output": "str",
    "x": 360,
